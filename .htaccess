RewriteRule ^communities\.html$ /dre-homes-new-ui/communities [R=301,L,NC]
RewriteRule ^company-news\.html$ /dre-homes-new-ui/company-news [R=301,L,NC]
RewriteRule ^developers\.html$ /dre-homes-new-ui/developers [R=301,L,NC]
RewriteRule ^golden-visa\.html$ /dre-homes-new-ui/golden-visa [R=301,L,NC]
RewriteRule ^landlord-guide\.html$ /dre-homes-new-ui/landlord-guide [R=301,L,NC]
RewriteRule ^podcast\.html$ /dre-homes-new-ui/podcast [R=301,L,NC]
RewriteRule ^privacy-policy\.html$ /dre-homes-new-ui/privacy-policy [R=301,L,NC]
RewriteRule ^seller-guide\.html$ /dre-homes-new-ui/seller-guide [R=301,L,NC]
RewriteRule ^tenant-guide\.html$ /dre-homes-new-ui/tenant-guide [R=301,L,NC]
RewriteRule ^terms-conditions\.html$ /dre-homes-new-ui/terms-conditions [R=301,L,NC]
RewriteRule ^news-sobha-top-channel-partner(\.html)?$ /dre-homes-new-ui/company-news/dre-homes-recognised-as-a-top-performing-channel-partner-sobha-realty [R=301,L,NC]
RewriteRule ^brand-video\.html$ /dre-homes-new-ui/brand-video [R=301,L,NC]
RewriteRule ^dre-brand-video(\.html)?$ /dre-homes-new-ui/brand-video [R=301,L,NC]
RewriteRule ^team-qurat-ul-ain(\.html)?$ /dre-homes-new-ui/our-team/qurat-ul-ain [R=301,L,NC]
RewriteCond %{QUERY_STRING} (?:^|&)u=([^&]+)
RewriteRule ^team-member\.html$ /dre-homes-new-ui/our-team/%1 [R=301,L,NC,QSD]
RewriteRule ^team-member\.html$ /dre-homes-new-ui/our-team [R=301,L,NC]
RewriteRule ^team-member/?$ agent-single.php [NC,L,QSA]

## New UI: a page.html that has a dynamic page.php twin is served by the PHP (URL stays .html)
RewriteRule ^blog-freehold-vs-leasehold(\.html)?$ /dre-homes-new-ui/our-blogs/freehold-vs-leasehold-property-in-dubai [R=301,L,NC]

RewriteCond %{REQUEST_FILENAME} ^(.+)\.html$
RewriteCond %1.php -f
RewriteRule ^(.+)\.html$ $1.php [L,QSA]

## If the request is for a valid directory
RewriteCond %{REQUEST_FILENAME} -d [OR]
## If the request is for a valid file
RewriteCond %{REQUEST_FILENAME} -f [OR]
## If the request is for a valid link
RewriteCond %{REQUEST_FILENAME} -l
## don't do anything
RewriteRule ^ - [L]

RewriteRule ^sitemap\.xml$ sitemap.php [L,QSA]
RewriteRule ^blog-sitemap\.xml$ blog-sitemap.php [L,QSA]
RewriteRule ^developer-sitemap\.xml$ developer-sitemap.php [L,QSA]
RewriteRule ^community-sitemap\.xml$ community-sitemap.php [L,QSA]
RewriteRule ^property-sitemap\.xml$ property-sitemap.php [L,QSA]
RewriteRule ^property2-sitemap\.xml$ property2-sitemap.php [L,QSA]

## New UI clean URLs: /page/ -> 301 to /page (keeps relative asset paths working)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} ^(.+)/$
RewriteRule ^[A-Za-z0-9-]+/$ %1 [R=301,L]
## /page -> page.php (dynamic) or page.html (still static)
RewriteCond %{REQUEST_FILENAME} ^(.+?)/?$
RewriteCond %1.php -f
RewriteRule ^([A-Za-z0-9-]+)/?$ $1.php [L,QSA]
RewriteCond %{REQUEST_FILENAME} ^(.+?)/?$
RewriteCond %1.html -f
RewriteRule ^([A-Za-z0-9-]+)/?$ $1.html [L,QSA]



Redirect /404/ https://drehomes.com/404

# === Block direct access to certain .php files under disallowed sub-directories ===

# List of subdirectories to protect
SetEnvIf Request_URI ^/community/ baddir
SetEnvIf Request_URI ^/property/ baddir
SetEnvIf Request_URI ^/buy-property/ baddir
SetEnvIf Request_URI ^/rent-property/ baddir
SetEnvIf Request_URI ^/international-properties/ baddir
SetEnvIf Request_URI ^/ready-to-move-in/ baddir
SetEnvIf Request_URI ^/offplan-properties/ baddir
SetEnvIf Request_URI ^/careers/ baddir

# If the request is for .php files like about-us.php, contact-us.php, index.php, etc., in those dirs => 404
RewriteCond %{ENV:baddir} =1
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/[^?\s]*\.(?:php)\s [NC]
RewriteRule ^ - [R=404,L]

# Also block /property/width= or other malformed queryless “paths”
RewriteCond %{ENV:baddir} =1
# If after the directory there's something with = (i.e. not a clean URL) or extension not allowed
RewriteRule ^(community|property|buy-property|rent-property|international-properties|ready-to-move-in|offplan-properties|careers)/.*=.*$  - [R=404,L]



# Set a custom 404 error page
ErrorDocument 404 https://drehomes.com/404

