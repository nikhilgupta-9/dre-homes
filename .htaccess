# === Page speed: compress text files, let browsers keep static files ===
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/javascript text/javascript application/json application/xml image/svg+xml font/ttf application/x-font-ttf
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/gif "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 month"
  ExpiresByType video/mp4 "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/ttf "access plus 1 year"
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
  ExpiresByType text/javascript "access plus 1 week"
</IfModule>

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteCond %{HTTPS} off
RewriteCond %{HTTP_HOST} ^(www\.)?drehomes\.com$ [NC]
RewriteRule ^(.*)$ https://drehomes.com/$1 [L,R=301]
</IfModule>

RewriteEngine on

# Never serve internal files (config, database layer, AI internals, dumps, logs)
RewriteRule (^|/)\.(git|env) - [F,L]
RewriteRule \.(md|log|sql|bak|lock)$ - [F,L,NC]
RewriteRule ^(config|db)/ - [F,L]
RewriteRule ^ai/(cron|tests|storage)/ - [F,L]
# Class and settings files in ai/ are included by PHP, never requested
RewriteRule ^ai/(config|[A-Z][A-Za-z]*)\.php$ - [F,L]

#RewriteCond %{HTTPS} off
#RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

#ErrorDocument 404 /404.php

## If the request is for a valid directory
RewriteCond %{REQUEST_FILENAME} -d [OR]
## If the request is for a valid file
RewriteCond %{REQUEST_FILENAME} -f [OR]
## If the request is for a valid link
RewriteCond %{REQUEST_FILENAME} -l
## don't do anything
RewriteRule ^ - [L]

RewriteRule ^sitemap\.xml$ sitemap.php [L,QSA]
RewriteRule ^blog-sitemap\.xml$ blog-sitemap.php [L,QSA]
RewriteRule ^developer-sitemap\.xml$ developer-sitemap.php [L,QSA]
RewriteRule ^community-sitemap\.xml$ community-sitemap.php [L,QSA]
RewriteRule ^property-sitemap\.xml$ property-sitemap.php [L,QSA]
RewriteRule ^property2-sitemap\.xml$ property2-sitemap.php [L,QSA]



Redirect /404/ https://drehomes.com/404

# === Block direct access to certain .php files under disallowed sub-directories ===

# List of subdirectories to protect
SetEnvIf Request_URI ^/community/ baddir
SetEnvIf Request_URI ^/property/ baddir
SetEnvIf Request_URI ^/buy-property/ baddir
SetEnvIf Request_URI ^/rent-property/ baddir
SetEnvIf Request_URI ^/international-properties/ baddir
SetEnvIf Request_URI ^/ready-to-move-in/ baddir
SetEnvIf Request_URI ^/offplan-properties/ baddir
SetEnvIf Request_URI ^/careers/ baddir

# If the request is for .php files like about-us.php, contact-us.php, index.php, etc., in those dirs => 404
RewriteCond %{ENV:baddir} =1
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/[^?\s]*\.(?:php)\s [NC]
RewriteRule ^ - [R=404,L]

# Also block /property/width= or other malformed queryless “paths”
RewriteCond %{ENV:baddir} =1
# If after the directory there's something with = (i.e. not a clean URL) or extension not allowed
RewriteRule ^(community|property|buy-property|rent-property|international-properties|ready-to-move-in|offplan-properties|careers)/.*=.*$  - [R=404,L]



# Set a custom 404 error page
ErrorDocument 404 https://drehomes.com/404

RewriteRule   ^404?$   404.php  [NC]
RewriteRule   ^404/?$   404.php  [NC]

RewriteRule   ^our-media?$   gallery.php  [NC]
RewriteRule   ^our-media/?$   gallery.php  [NC]

RewriteRule   ^about-us?$   about-us.php  [NC]
RewriteRule   ^about-us/?$   about-us.php  [NC]

