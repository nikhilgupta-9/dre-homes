# Uploaded CVs are documents only: never run scripts from this folder
<FilesMatch "\.(php\d?|phtml|phar|pl|py|cgi|sh|shtml|html?|js|svg)$">
  Require all denied
</FilesMatch>
Options -ExecCGI -Indexes
<IfModule mod_php.c>
  php_flag engine off
</IfModule>
<IfModule mod_php7.c>
  php_flag engine off
</IfModule>
<IfModule mod_php8.c>
  php_flag engine off
</IfModule>
